    "src/pages/FixedNewProfilePage.tsx",
    "src/pages/HomePage.tsx",
    "src/pages/index.tsx",
    "src/pages/InnovativeRegister.tsx",
    "src/pages/JobOffers.tsx",
    "src/pages/layout.tsx",
    "src/pages/LoadingScreen.tsx",
    "src/pages/Login.tsx",
