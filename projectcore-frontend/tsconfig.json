    "src/pages/MotivationPage.tsx",
    "src/pages/NewProfilePage.tsx",
    "src/pages/NewStudentDashboard.tsx",
    "src/pages/not-found.tsx",
    "src/pages/PersonalizedCompanyDashboard.tsx",
    "src/pages/PersonalizedStudentDashboard.tsx",
    "src/pages/politica-privacidad.tsx",
