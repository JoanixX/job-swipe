# URL base del backend principal (FastAPI, puerto 8000). En dev se puede omitir:
# Vite proxya /api -> http://localhost:8000
VITE_API_URL=/api

# Origen del backend sin sufijo /api (usado por user-registration)
VITE_API_ORIGIN=http://localhost:8000

# Servicio IA (kawsai) para extracción de skills del CV
VITE_IA_API_URL=http://localhost:8001/api
