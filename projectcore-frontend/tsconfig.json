    "src/pages/RegisterCompany.tsx",
    "src/pages/RegisterSelection.tsx",
    "src/pages/RegisterStudent.tsx",
    "src/pages/RegistrationDemo.tsx",
    "src/pages/SignUpPage.tsx",
    "src/pages/SimpleCompanyDashboard.tsx",
    "src/pages/SimpleRegisterStudent.tsx",
    "src/pages/SimpleStudentDashboard.tsx",
    "src/pages/StudentDashboard.tsx",
    "src/pages/StudentProfile.tsx",
    "src/pages/terminos-servicio.tsx",
    "src/pages/crew",
    "src/pages/community",
    "src/pages/launch"
  ],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "noImplicitAny": false,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
