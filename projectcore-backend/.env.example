# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobswipe

# JWT
SECRET_KEY=cambia-esta-clave-secreta

# Envío de correos (recuperación de contraseña).
# Si SMTP_HOST queda vacío, el backend loggea el enlace en consola (modo dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail
SMTP_FROM=JobSwipe <no-reply@jobswipe.com>

# URL del frontend para armar los enlaces de recuperación
FRONTEND_URL=http://localhost:5000

# Minutos de validez del enlace de recuperación
RESET_TOKEN_EXPIRE_MINUTES=30
